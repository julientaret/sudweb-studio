# VARIABLES D'ENVIRONNEMENT — MODÈLE
#
# Copiez ce fichier en .env.local à la racine du projet et renseignez vos
# valeurs. .env.local contient les constantes propres à votre serveur et n'est
# PAS versionné (voir .gitignore) : ne committez jamais vos secrets.

DB_HOST=127.0.0.1
DB_NAME=flow-cms
DB_USER=root
DB_PASS=

PROD=false
DOC_ROOT=/chemin/absolu/vers/flow-cms/
HTTP=http://localhost/flow-cms/

EMAIL_CONTACT=contact@example.com
EMAIL_SENDER=no-reply@example.com

# Stockage des fichiers uploadés. Vide = défaut sous public/ (public/uploads,
# public/documents). En prod, pour sortir les fichiers du dossier flow-cms :
#   - *_PATH : chemin disque absolu du dossier de stockage ;
#   - *_URL  : URL publique. Laissez vide si le dossier est servi à la même URL
#              (symlink depuis public/, ou Alias Apache / location Nginx).
# IMPORTANT : recopiez le .htaccess (coupure d'exécution de scripts) dans le
# nouveau dossier. Voir config/storage.php.
#UPLOADS_PATH=/var/data/flow/uploads
#UPLOADS_URL=
#DOCUMENTS_PATH=/var/data/flow/documents
#DOCUMENTS_URL=

# Module Avis Google (voir config/google_reviews.php) : clé API Google Places
# (projet GCP avec facturation activée). L'établissement se choisit ensuite
# directement dans l'admin du module (recherche par nom).
#GOOGLE_PLACES_API_KEY=
