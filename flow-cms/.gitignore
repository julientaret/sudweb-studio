# OS / éditeurs
._*
.DS_Store
.idea/
.vscode/
prepros-6.config
config.codekit*

# Environnement (constantes propres au serveur)
.env.local

# Généré (Composer à la racine uniquement, pas les libs front vendorisées)
node_modules/
/vendor/
dist/

# Libs front auto-hébergées (Cropper.js, Quill…) : versionnées.
!/public/assets/vendor/

# Données utilisateur : jamais versionnées.
# (uploads médias ET documents vivent désormais dans frontend/public — voir le
# .gitignore du frontend ; ici ne reste que le storage interne.)
/storage/logs/*
/storage/cache/*
/storage/modules.json
/storage/google_reviews.json
/storage/aos.json

# …mais on garde la structure.
!/storage/logs/.gitkeep
!/storage/cache/.gitkeep

# Scanner / analyse
.scannerwork/
