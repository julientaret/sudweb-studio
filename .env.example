# VARIABLES D'ENVIRONNEMENT — MODÈLE
#
# Copiez ce fichier en .env.local À LA RACINE du projet (flow/) et renseignez vos
# valeurs. .env.local est partagé par l'admin (flow-cms) et le site public
# (frontend), et n'est PAS versionné (voir .gitignore) : ne committez jamais vos
# secrets.

# Base de données
DB_HOST=127.0.0.1
DB_NAME=flow-cms
DB_USER=root
DB_PASS=

# Environnement
PROD=false

# URL absolue du site public (sans slash final).
#   - dev   : http://localhost/flow
#   - prod  : https://www.monsite.com
# Sert de base aux URLs des médias et documents (absolues, donc indépendantes du
# nom du dossier d'installation) et aux liens absolus (mails…).
APP_URL=http://localhost/flow

# E-mails
EMAIL_CONTACT=contact@example.com
EMAIL_SENDER=no-reply@example.com

# Stockage des fichiers uploadés. Vide = défaut dans le site public
# (frontend/public/uploads et frontend/public/documents). Pour sortir les
# fichiers du projet (prod) :
#   - *_PATH : chemin disque absolu du dossier de stockage ;
#   - *_URL  : URL publique complète (CDN, sous-domaine…). Laissez vide pour
#              dériver de APP_URL, ou pour rester sur le chemin auto-détecté.
# IMPORTANT : recopiez le .htaccess (coupure d'exécution de scripts) dans le
# nouveau dossier. Voir config/storage.php.
#UPLOADS_PATH=/var/data/flow/uploads
#UPLOADS_URL=
#DOCUMENTS_PATH=/var/data/flow/documents
#DOCUMENTS_URL=

# Module Avis Google (voir config/google_reviews.php) : clé API Google Places
# (projet GCP avec facturation activée). L'établissement se choisit ensuite
# directement dans l'admin du module (recherche par nom).
#GOOGLE_PLACES_API_KEY=
